# Copy this file to .env (cp env.example .env) — .env itself is gitignored.

# === Local dev (default): Docker Firestore emulator ===
# Start it first from proj2/: docker compose up -d
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_PROJECT_ID=demo-hungry-wolf

# === Real Firebase project (alternative) ===
# Remove FIRESTORE_EMULATOR_HOST above and fill these from a service-account key
# (Firebase Console > Project settings > Service accounts > Generate new private key)
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_PRIVATE_KEY_ID=your-private-key-id
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_CLIENT_ID=your-client-id
# FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
# FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token

# Server
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Optional features (app runs without these)
# GEMINI_API_KEY=          # voice ordering (/api/voice)
# GOOGLE_MAPS_API_KEY=     # server-side geocoding
